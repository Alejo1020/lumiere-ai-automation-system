    {
      "id": "b-result",
      "name": "Return Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        600
      ],
      "parameters": {
        "jsCode": "// What the caller gets: ok + the appointment, or the reason it could not be done.\n// Lo que recibe quien llamó: ok + la cita, o el motivo por el que no se pudo.\n// reason: taken | outside_hours | too_soon | too_far | invalid_time | no_active_appointment | calendar_error | invalid_op | already_booked\nconst v = $('Validate Request').first().json;\nconst r = v.request;\nconst ran = n => $(n).isExecuted;\nlet ok = false, reason = v.error || '', cita_id = v.cita ? v.cita.cita_id : '';\nif (v.dup) { ok = true; reason = 'already_booked'; }\nelse if (!v.error) {\n  if (v.op === 'cancel') ok = ran('Cancel Cita');\n  else if (v.op === 'confirm') ok = ran('Confirm Cita');\n  else {\n    const d = $('Slot Decision').first().json;\n    if (!d.free) reason = d.error || 'taken';\n    else if (v.op === 'book') { ok = ran('Save Cita'); cita_id = v.new_cita_id; if (!ok) reason = 'calendar_error'; }\n    else { ok = ran('Update Cita'); if (!ok) reason = 'calendar_error'; }\n  }\n}\nreturn [{ json: { ok, op: v.op, reason: ok && reason !== 'already_booked' ? '' : reason, cita_id,\n  inicio: v.start || (v.cita ? v.cita.inicio : ''), fin: v.end || (v.cita ? v.cita.fin : ''), servicio: r.servicio || (v.cita ? v.cita.servicio : '') } }];"
      }
