{
  "name": "P31g - Lumière Booking",
  "nodes": [
    {
      "id": "b-trigger",
      "name": "When Called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        200
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "request",
              "type": "object"
            }
          ]
        }
      }
    },
    {
      "id": "b-validate",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "jsCode": "// Checks the request against the Negocio rules BEFORE touching the calendar.\n// Revisa la petición contra las reglas de Negocio ANTES de tocar el calendario.\n// request: { op: book|reschedule|cancel|confirm, lead_id, nombre, whatsapp, servicio_id, servicio, duracion_min,\n//            start: 'yyyy-MM-dd HH:mm', cita (active appointment row or null), negocio }\nconst r = $('When Called').first().json.request || {};\nconst n = r.negocio || {};\nconst tz = n.zona_horaria || 'America/Phoenix';\nconst BLOCK = Number(n.bloque_min) || 60;\nconst op = r.op;\nconst cita = r.cita && r.cita.cita_id ? r.cita : null;\nconst parse = v => { const m = String(v || '').match(/(\\d{1,2}):(\\d{2})\\s*-\\s*(\\d{1,2}):(\\d{2})/); return m ? { o: +m[1] * 60 + +m[2], c: +m[3] * 60 + +m[4] } : null; };\nconst HOURS = { 1: parse(n.horario_lun_vie), 2: parse(n.horario_lun_vie), 3: parse(n.horario_lun_vie), 4: parse(n.horario_lun_vie), 5: parse(n.horario_lun_vie), 6: parse(n.horario_sab), 7: parse(n.horario_dom) };\n\nlet error = '';\nif (!['book', 'reschedule', 'cancel', 'confirm'].includes(op)) error = 'invalid_op';\nelse if (op !== 'book' && !cita) error = 'no_active_appointment';\nelse if (!n.calendar_id) error = 'calendar_error';\n\nlet s = null, e = null;\nif (!error && op !== 'cancel' && op !== 'confirm') {\n  s = DateTime.fromFormat(String(r.start || ''), 'yyyy-MM-dd HH:mm', { zone: tz });\n  if (!s.isValid) error = 'invalid_time';\n  else {\n    const blocks = Math.max(1, Math.ceil((Number(r.duracion_min) || BLOCK) / BLOCK)); // 90 min = 2 bloques\n    e = s.plus({ minutes: blocks * BLOCK });\n    const now = $now.setZone(tz);\n    const h = HOURS[s.weekday];\n    const sMin = s.hour * 60 + s.minute;\n    if (!h || sMin < h.o || sMin + blocks * BLOCK > h.c || (sMin - h.o) % BLOCK !== 0) error = 'outside_hours';\n    else if (s.toMillis() < now.plus({ hours: Number(n.anticipacion_min_horas) || 2 }).toMillis()) error = 'too_soon';\n    else if (s.toMillis() > now.plus({ days: Number(n.dias_max_agenda) || 14 }).endOf('day').toMillis()) error = 'too_far';\n  }\n}\n\n// She said \"yes\" twice: the same appointment already exists -> nothing to do\n// Dijo \"sí\" dos veces: la misma cita ya existe -> no se hace nada\nconst dup = !error && op === 'book' && cita && cita.inicio === r.start;\nconst now = $now.setZone(tz);\n\nreturn [{ json: {\n  op, error, dup, tz,\n  calId: n.calendar_id,\n  calIdEnc: encodeURIComponent(n.calendar_id || ''),\n  start: s && s.isValid ? s.toFormat('yyyy-MM-dd HH:mm') : '',\n  end: e ? e.toFormat('yyyy-MM-dd HH:mm') : '',\n  startISO: s && s.isValid ? s.toISO() : '',\n  endISO: e ? e.toISO() : '',\n  new_cita_id: 'CIT-' + now.toFormat('yyyyMMdd') + '-' + Math.random().toString(36).slice(2, 7).toUpperCase(),\n  fb_body: e ? { timeMin: s.toISO(), timeMax: e.toISO(), timeZone: tz, items: [{ id: n.calendar_id }] } : null,\n  check_calendar: !error && !dup && op !== 'cancel' && op !== 'confirm',\n  do_cancel: !error && op === 'cancel',\n  do_confirm: !error && op === 'confirm',   // P33: she answered \"yes\" to a reminder / respondió \"sí\" a un recordatorio\n  request: r,\n  cita\n} }];"
      }
    },
