    {
      "id": "b-decide",
      "name": "Slot Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "jsCode": "// Is the slot still free right now? (her own current appointment does not block a reschedule)\n// ¿El horario sigue libre en este momento? (su propia cita actual no bloquea una reprogramación)\nconst v = $('Validate Request').first().json;\nconst res = $input.first().json || {};\nconst cal = (res.calendars || {})[v.calId] || {};\nif (cal.errors || !res.calendars) return [{ json: { free: false, error: 'calendar_error' } }];\nlet busy = (cal.busy || []).map(b => ({ s: DateTime.fromISO(b.start).toMillis(), e: DateTime.fromISO(b.end).toMillis() }));\nconst c = v.cita;\nif (v.op === 'reschedule' && c && c.inicio && c.fin) {\n  const cs = DateTime.fromFormat(c.inicio, 'yyyy-MM-dd HH:mm', { zone: v.tz }).toMillis();\n  const ce = DateTime.fromFormat(c.fin, 'yyyy-MM-dd HH:mm', { zone: v.tz }).toMillis();\n  busy = busy.filter(b => !(b.s >= cs && b.e <= ce));\n}\nconst s = DateTime.fromISO(v.startISO).toMillis();\nconst e = DateTime.fromISO(v.endISO).toMillis();\nreturn [{ json: { free: !busy.some(b => b.s < e && b.e > s), error: '' } }];"
      }
    },
