    {
      "parameters": {
        "jsCode": "// Valida y limpia el lead que llega de la landing (nunca confiar solo en el navegador)\nconst b = $input.first().json.body || {};\nconst txt = (v) => (v == null ? '' : String(v)).trim();\nconst errores = [];\n\n// Honeypot: campo oculto que solo llenan los bots\nif (txt(b.website)) errores.push('spam');\n\nconst nombre = txt(b.nombre).slice(0, 120);\nif (nombre.length < 2) errores.push('nombre');\n\n// WhatsApp a E.164: 10 dígitos = EEUU/Canadá (+1); con código de país, 11 a 15 dígitos\nconst digits = txt(b.telefono).replace(/\\D/g, '');\nlet whatsapp = '';\nif (digits.length === 10) whatsapp = '+1' + digits;\nelse if (digits.length >= 11 && digits.length <= 15) whatsapp = '+' + digits;\nelse errores.push('telefono');\n\nconst tratamiento = txt(b.servicio).slice(0, 80);\nif (!tratamiento) errores.push('servicio');\n\n// Email opcional, pero si viene debe tener formato válido\nconst email = txt(b.email).toLowerCase().slice(0, 160);\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errores.push('email');\n\n// Consentimiento: obligatorio, con el canal y el texto exacto que aceptó.\n// Acepta también el payload viejo (sms_consent) para que ningún lead falle durante el cambio.\nconst esViejo = b.consent === undefined && b.sms_consent !== undefined;\nconst consent = [true, 'true'].includes(esViejo ? b.sms_consent : b.consent);\nconst consent_canal = esViejo ? 'sms' : (['whatsapp', 'sms'].includes(txt(b.consent_canal)) ? txt(b.consent_canal) : 'whatsapp');\nconst consent_text = txt(b.consent_text).slice(0, 1000);\nif (!consent) errores.push('consent');\nelse if (!consent_text) errores.push('consent_text');\n\nconst ahora = $now.setZone('America/Phoenix').toFormat('yyyy-MM-dd HH:mm:ss');\n\nreturn [{ json: {\n  valido: errores.length === 0,\n  errores,\n  nombre,\n  whatsapp,\n  email,\n  tratamiento,\n  primera_vez: ['si', 'no'].includes(txt(b.primera_vez)) ? txt(b.primera_vez) : '',\n  comentario: txt(b.comentario).slice(0, 1000),\n  idioma: txt(b.idioma) === 'es' ? 'es' : 'en',\n  consent_canal,\n  consent_text,\n  fecha: ahora\n} }];"
      },
