    {
      "parameters": {
        "jsCode": "// Une el lead nuevo con la fila que ya existía (la misma persona envía otra vez)\nconst lead = $('Validate Lead').first().json;\nconst previo = $input.first().json || {}; // vacío si es lead nuevo (Always Output Data)\nconst existe = Boolean(previo.row_number);\n\n// Historial: \"Botox / Dysport → Láser facial\" (no repite si elige el mismo dos veces seguidas)\nconst historial = existe ? String(previo.tratamientos_historial || previo.tratamiento || '').split(' → ').filter(Boolean) : [];\nif (historial[historial.length - 1] !== lead.tratamiento) historial.push(lead.tratamiento);\n\nconst nuevoId = 'LUM-' + $now.setZone('America/Phoenix').toFormat('yyyyMMdd') + '-' + Math.random().toString(36).slice(2, 7).toUpperCase();\n\nreturn [{ json: {\n  lead_id: existe && previo.lead_id ? previo.lead_id : nuevoId,\n  fecha_creacion: existe && previo.fecha_creacion ? previo.fecha_creacion : lead.fecha,\n  nombre: lead.nombre,\n  whatsapp: lead.whatsapp,\n  email: lead.email || (existe ? previo.email || '' : ''),\n  tratamiento: lead.tratamiento,\n  tratamientos_historial: historial.join(' → '),\n  primera_vez: lead.primera_vez || (existe ? previo.primera_vez || '' : ''),\n  comentario: lead.comentario,\n  idioma: lead.idioma,\n  consent_canal: lead.consent_canal,\n  consent_text: lead.consent_text,\n  consent_fecha: lead.fecha,\n  estado: existe && previo.estado ? previo.estado : 'nuevo',   // P31 define los demás estados\n  envios: existe ? (Number(previo.envios) || 1) + 1 : 1,\n  ultima_actualizacion: lead.fecha,\n  es_duplicado: existe\n} }];"
      },
